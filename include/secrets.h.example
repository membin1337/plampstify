#pragma once

// Copy this file to secrets.h (gitignored - see .gitignore) and fill in
// real values before building. wifi_manager.cpp includes secrets.h.
//
// Index 0 is the PRIMARY network - the only one static IP config (see
// config.h's STATIC_IP) is applied for; see wifi_manager.cpp. Additional
// entries are DHCP-only fallbacks, tried via WiFiMulti (best signal wins)
// whenever the primary isn't reachable.
struct WifiCredential {
  const char* ssid;
  const char* password;
};

constexpr WifiCredential WIFI_CREDENTIALS[] = {
  {"your-primary-wifi-ssid", "your-primary-wifi-password"},
  // {"your-backup-wifi-ssid", "your-backup-wifi-password"},
};
constexpr size_t WIFI_CREDENTIAL_COUNT = sizeof(WIFI_CREDENTIALS) / sizeof(WIFI_CREDENTIALS[0]);

constexpr const char* OTA_PASSWORD = "your-ota-password"; // must match platformio.ini's --auth flag

// Gates this device's write endpoints (actuators, /settings, /server-
// address) - must match plampControlCenter/server's DEVICE_API_KEY env
// var exactly. Generate a real random value, e.g.:
//   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
constexpr const char* DEVICE_API_KEY = "your-device-api-key";
